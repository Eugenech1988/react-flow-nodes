{
  "name": "pipeline-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,json,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,md,json,cjs,mjs}\"",
    "clean": "rimraf .turbo node_modules \"apps/**/{node_modules,dist,.next,out,.astro}\" \"packages/**/{node_modules,dist}\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
