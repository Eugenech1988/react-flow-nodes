---
import { ArrowLeft, Compass, Unplug } from '@lucide/astro';
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Not Found | Pipeline Studio">
    <div class="relative min-h-screen bg-slate-950 text-slate-100 flex flex-col justify-center items-center overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-teal-950/20)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-teal-950/20)_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-60 pointer-events-none"></div>

        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative max-w-xl mx-auto px-6 text-center z-10 animate-fade-in">

            <div class="relative p-8 bg-slate-900/60 border border-slate-800 hover:border-teal-500/30 rounded-2xl backdrop-blur-xl shadow-2xl transition-all duration-300 group">

                <div class="w-12 h-12 mx-auto mb-6 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 transition-transform duration-300">
                    <Unplug class="w-6 h-6 animate-pulse"/>
                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-teal-400 via-slate-100 to-white mb-3 leading-tight">
                    Oops! We couldn't find that page
                </h1>
                <p class="text-sm text-slate-400 leading-relaxed mb-8">
                    The page you are looking for might have been moved, deleted, or never existed. Let's get you back on
                    track.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a
                            href="/"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-xs font-semibold text-slate-950 bg-teal-400 hover:bg-teal-300 rounded-xl shadow-lg shadow-teal-500/10 transition-all cursor-pointer active:scale-95"
                    >
                        <ArrowLeft class="w-4 h-4 text-slate-950"/>
                        Back to Main
                    </a>

                    <a
                            href="/docs"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-xs font-semibold text-slate-300 bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 rounded-xl transition-all cursor-pointer active:scale-95"
                    >
                        <Compass class="w-4 h-4 text-teal-400"/>
                        Browse Documentation
                    </a>
                </div>

            </div>

            <div class="mt-12 text-xs text-slate-600 font-mono">
                &copy; {new Date().getFullYear()} Pipelines Studio Inc. All rights reserved.
            </div>

        </div>
    </div>
</Layout>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>