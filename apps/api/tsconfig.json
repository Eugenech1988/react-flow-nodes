{
  "extends": "@pipeline/typescript-config/nest",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "test", "prisma", "prisma.config.ts"]
}
