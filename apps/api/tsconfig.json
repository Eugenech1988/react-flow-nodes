{
  "extends": "@pipeline/typescript-config/nest",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "test", "prisma", "prisma.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "prisma.config.ts",
    "**/*.spec.ts"
  ]
}
