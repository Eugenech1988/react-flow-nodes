<div style="font-family: Arial, sans-serif; color: #333; line-height: 1.5; padding: 16px;">
    <h3 style="color: #0f172a; margin-top: 0;">New Demo Request</h3>
    <p><strong>Name:</strong> {{firstName}} {{lastName}}</p>
    <p><strong>Email:</strong> {{email}}</p>
    <p><strong>Company:</strong> {{company}}</p>
    <p><strong>Volume:</strong> {{volume}}</p>
    <p><strong>Message:</strong></p>
    <blockquote style="background: #f8fafc; padding: 10px; border-left: 4px solid #0d9488; margin: 0;">
        {{message}}
    </blockquote>
</div>