{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/src", "<rootDir>/test"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@pipeline/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
    "^@pipeline/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}